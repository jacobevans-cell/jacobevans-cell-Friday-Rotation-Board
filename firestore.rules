rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function email() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email
        : '';
    }

    function isAdmin() {
      return signedIn() && (
        email() == 'jacob.evans@explore.academy' ||
        email() == 'jacobicusjax@gmail.com'
      );
    }

    function validStaffPair(data) {
      return (data.staffName == 'Lingam' && data.staffKey == 'lingam')
        || (data.staffName == 'Evans' && data.staffKey == 'evans')
        || (data.staffName == 'Latoya' && data.staffKey == 'latoya')
        || (data.staffName == 'Meda' && data.staffKey == 'meda')
        || (data.staffName == 'Abby' && data.staffKey == 'abby');
    }

    function validRequest(requestId, data) {
      return data.keys().hasOnly([
          'staffName', 'staffKey', 'fridayDate', 'canSwap', 'submittedAt'
        ])
        && data.staffName is string
        && data.staffKey is string
        && data.fridayDate is string
        && data.fridayDate.matches('20(26|27)-[0-9]{2}-[0-9]{2}')
        && data.canSwap is bool
        && data.submittedAt == request.time
        && validStaffPair(data)
        && requestId == data.staffKey + '__' + data.fridayDate;
    }

    match /fridayOffRequests/{requestId} {
      allow read: if isAdmin();

      // Staff do not need to sign in. Public submissions are restricted to
      // the five approved staff names, a valid school-year date string, and
      // the deterministic staff+date document id.
      allow create, update: if validRequest(requestId, request.resource.data);

      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
